@using view_practice.Models
@model IEnumerable<Person>

@functions {
    double? GetAge(DateTime? dateOfBirth)
    {
        if (dateOfBirth is not null)
        {
            return Math.Round((DateTime.Now - dateOfBirth.Value).TotalDays / 365.25);
        }
        else
        {
            return null;
        }
    }
}

@{
    Person person = (Person)ViewData["person"]!;
    @* List<Person> people = (List<Person>)ViewData["people"]! ?? new List<Person>(); *@
}



<!DOCTYPE html>
<html>

<head>
    <title>@ViewData["appTitle"]</title>
    <meta charset="utf-8" />
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>

<body>
    <h1>Employee</h1>
    <h3>Number of Person @ViewBag.people.Count</h3>
    <p>Name: @person.name</p>
    <p>Date of Birth: @person.dateOfBirth</p>
    @if (person.dateOfBirth.HasValue)
    {
        <p>Age: @GetAge(person.dateOfBirth) years old</p>
    }
    else
    {
        <p>Age: Unknown</p>
    }

    @switch (person.personGender)
    {
        case Gender.Male:
            <p>You are a male</p>
            break;

        case Gender.Female:
            <p>You are a female</p>
            break;

        default:
            <p>Gender: Other</p>
            break;
    }


    <h2>Some People</h2>
    <div class="page-content">
        @foreach (Person p in Model)
        {
            <div class="box">
                <p>Name: @p.name</p>
                @if (p.dateOfBirth != null)
                {
                    <p>DoB: @GetAge(p.dateOfBirth) years old</p>
                }
                <p>Gender: @p.personGender</p>
            </div>

        }
    </div>

</body>

</html>